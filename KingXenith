# KingXenith.ps1
# Automatically requests Administrator privileges.
$ErrorActionPreference = 'SilentlyContinue'

$principal = New-Object Security.Principal.WindowsPrincipal([Security.Principal.WindowsIdentity]::GetCurrent())
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Start-Process powershell.exe -Verb RunAs -ArgumentList @(
        '-NoProfile',
        '-ExecutionPolicy', 'Bypass',
        '-File', "`"$PSCommandPath`""
    )
    exit
}

$Host.UI.RawUI.WindowTitle = 'Setting Xenith'
try {
    $Host.UI.RawUI.ForegroundColor = 'Green'
    $Host.UI.RawUI.WindowSize = New-Object System.Management.Automation.Host.Size(95,30)
} catch {}

Clear-Host
Write-Host ''
Write-Host '           XX   XX  EEEEEEE  NN   NN   IIIIIII  TTTTTTT  HH   HH'
Write-Host '            XX XX   EE       NNN  NN     III      TTT    HH   HH'
Write-Host '             XXX    EEEEE    NN N NN     III      TTT    HHHHHHH'
Write-Host '            XX XX   EE       NN  NNN     III      TTT    HH   HH'
Write-Host '           XX   XX  EEEEEEE   NN   NN   IIIIIII   TTT    HH   HH'
Write-Host '    ============================================================='
Write-Host ''
Read-Host 'Press ENTER to start optimization'

$progress = 0
while ($progress -le 100) {
    Clear-Host
    Write-Host ''
    Write-Host 'Initializing KingXenith...'
    Write-Host ''
    $blocks = [math]::Floor($progress / 2)
    $bar = ('█' * $blocks)
    Write-Host "[$bar] $progress%"
    Write-Host ''
    Start-Sleep -Milliseconds 50
    $progress += 2
}

Clear-Host
Write-Host ''
Write-Host '[████████████████████████████████████████] 100%'
Write-Host ''
Write-Host 'Initializing Optimization KingXenith Setting...'
Start-Sleep -Seconds 1

Write-Host ''
Write-Host '[1/3] Applying KingXenith Setting...'
Start-Sleep -Seconds 1

& reg.exe add "HKEY_CURRENT_USER\Control Panel\Mouse" /v ActiveWindowTracking /t REG_DWORD /d 0 /f
& reg.exe add "HKEY_CURRENT_USER\Control Panel\Mouse" /v Beep /t REG_SZ /d No /f
& reg.exe add "HKEY_CURRENT_USER\Control Panel\Mouse" /v ExtendedSounds /t REG_SZ /d No /f
